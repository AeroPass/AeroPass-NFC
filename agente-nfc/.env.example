# El agente escucha solo en loopback por seguridad.
NFC_AGENT_HOST=127.0.0.1
NFC_AGENT_PORTS=8765,8766,8767,8768,8769,8770
NFC_AGENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Deja vacío para compatibilidad simple. En producción local, define una cadena aleatoria
# y modifica el frontend para enviar {"type":"auth","token":"..."} al conectarse.
NFC_AGENT_TOKEN=

# Intervalo de sondeo (segundos), entre 0.05 y 10.
NFC_AGENT_POLL_INTERVAL=0.35

# Opcional: nombre exacto del lector como lo expone PC/SC; vacío selecciona el primero.
NFC_AGENT_READER_NAME=

# Opcional: directorio de datos/logs/ID de dispositivo.
# NFC_AGENT_DATA_DIR=
