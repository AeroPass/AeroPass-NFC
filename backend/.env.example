NODE_ENV=development
PORT=3000
API_PREFIX=api

# Base de datos principal de AeroPass.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=cambiar_por_una_contrasena_segura
DB_DATABASE=aeropass_nfc
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Base de datos académica SIGEDIN; ambas conexiones son necesarias actualmente.
SIGEDIN_DB_HOST=localhost
SIGEDIN_DB_PORT=3306
SIGEDIN_DB_USERNAME=root
SIGEDIN_DB_PASSWORD=cambiar_por_una_contrasena_segura
SIGEDIN_DB_DATABASE=sigedin
SIGEDIN_DB_SYNCHRONIZE=false
SIGEDIN_DB_LOGGING=false

# Sustituir por un secreto aleatorio de al menos 32 caracteres antes de iniciar.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=8h
JWT_ISSUER=AeroPass-NFC
JWT_AUDIENCE=AeroPass-NFC-api

# Parámetros del registro de asistencia.
ATTENDANCE_TIME_ZONE=America/Bogota
ATTENDANCE_LATE_GRACE_MINUTES=10
NFC_TAP_COOLDOWN_SECONDS=5
