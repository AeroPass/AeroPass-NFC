NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=control_acceso_nfc

# Produccion: usa un secreto aleatorio de al menos 32 caracteres.
JWT_SECRET=dev-only-change-this-secret-to-at-least-32-characters
JWT_EXPIRES_IN=8h
JWT_ISSUER=AeroPass-NFC
JWT_AUDIENCE=AeroPass-NFC-api

# true por defecto. Sincroniza solamente los cuatro roles definidos
# y la matriz de permisos de la imagen entregada.
SECURITY_SYNC_ROLES_PERMISSIONS=true

# Conexion opcional al sistema academico externo.
SIGEDIN_DB_HOST=localhost
SIGEDIN_DB_PORT=3306
SIGEDIN_DB_USERNAME=
SIGEDIN_DB_PASSWORD=
SIGEDIN_DB_DATABASE=
