# =========================================================
# Plantilla de variables de entorno (SIN secretos reales)
# =========================================================
# Copia este archivo a .env y completa con tus valores reales:
#   cp .env.example .env
#
# ¡NUNCA subas tu archivo .env a GitHub! Ya está excluido en .gitignore
# =========================================================

# ---------- BASE DE DATOS MYSQL ----------
# Formato: mysql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="mysql://root:tu_password@localhost:3306/control_acceso_nfc"

# Ejemplos:
# DATABASE_URL="mysql://root:123456@localhost:3306/control_acceso_nfc"
# DATABASE_URL="mysql://admin:miPassword@localhost:3306/control_acceso_nfc"
# DATABASE_URL="mysql://usuario:password@192.168.1.100:3306/control_acceso_nfc"


# ---------- JWT ----------
# Secreto para firmar los JWT. Genera uno aleatorio con:
#   openssl rand -hex 32
JWT_SECRET="cambia-esto-por-una-cadena-aleatoria-muy-larga-y-secreta"
